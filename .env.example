# ==============================================================================
# NO EVERYTHING — Master Environment Configuration Template
# ==============================================================================

# FRONTEND VARIABLES (Vercel / Local Vite)
VITE_API_BASE_URL=http://localhost:8080

# BACKEND REST API VARIABLES (Render / Railway / Local Spring Boot)
# Port (Render and Railway set PORT automatically)
PORT=8080

# Production Database (MySQL - e.g., Aiven, PlanetScale, Railway MySQL, Clever Cloud)
# If omitted or left empty, the backend defaults to zero-config local persistent H2 in MySQL mode
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/noeverything?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_password
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

# Security & JSON Web Tokens
# Must be a 256-bit hexadecimal or Base64 secret string
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Google Gemini Generative AI (Backend only — NEVER expose in frontend)
# Obtain free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated if multiple)
FRONTEND_ORIGIN=https://no-everything.vercel.app,http://localhost:5173
